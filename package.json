{
  "name": "biblib",
  "version": "1.0.0",
  "description": "Citation and bibliography generator",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:format && npm run build:supabase",
    "start": "npm run build && node server.js",
    "build:format": "esbuild src/format.js --bundle --minify --platform=browser --format=iife --loader:.csl=text --loader:.xml=text --outfile=public/vendor/biblib-format.js",
    "build:supabase": "esbuild src/supabase.js --bundle --minify --platform=browser --format=iife --outfile=public/vendor/supabase.js"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@citation-js/plugin-ris": "^0.9.0",
    "@supabase/supabase-js": "^2.119.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0"
  },
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.160.0"
  }
}
